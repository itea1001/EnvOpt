diff --git a/evaluation/src/agent_runner.py b/evaluation/src/agent_runner.py
index bb8530d..e42f354 100644
--- a/evaluation/src/agent_runner.py
+++ b/evaluation/src/agent_runner.py
@@ -20,6 +20,36 @@ import agent_as_a_judge
 
 Json = Any
 
+# --- Agent-agnostic transient-error retry -------------------------------------
+# Some model endpoints intermittently return a transient failure (e.g. "model at
+# capacity", rate limits, overloaded/503) that fails the whole task even though a
+# re-run would succeed. We retry run_fn on these — identically for EVERY agent — so
+# the benchmark measures the agent, not luck with a flaky endpoint. Clean runs and
+# genuine (non-transient) errors are untouched: only an error-status result whose
+# message matches a transient marker is retried. Tune with WB_TRANSIENT_RETRIES
+# (default 3); set 0 to disable for a pure, no-retry measurement.
+_TRANSIENT_RETRIES = int(os.environ.get("WB_TRANSIENT_RETRIES", "3"))
+_TRANSIENT_MARKERS = (
+    "at capacity",
+    "try a different model",
+    "rate limit",
+    "rate_limit",
+    "overloaded",
+    "temporarily unavailable",
+    "service unavailable",
+    "try again later",
+    "turn.failed",
+)
+
+def _is_transient_error(run_res: Json) -> bool:
+    if not isinstance(run_res, dict):
+        return False
+    msg = run_res.get("errorMessage")
+    if not isinstance(msg, str) or not msg:
+        return False
+    low = msg.lower()
+    return any(m in low for m in _TRANSIENT_MARKERS)
+
 def _repo_root() -> Path:
     return Path(__file__).resolve().parent
 
@@ -539,17 +569,28 @@ def _run_one_case(
     raw_dir = os.path.join(case_dir, "raw")
