-        sandbox_dir=case_dir,
-        timeout_s=timeout_sec,
-        api_provider=api_provider2,
-    )
-    duration_ms = int((time.time() - case_started) * 1000)
+    # Run the agent; retry ONLY on transient infra errors (agent-agnostic, see top).
+    attempt = 0
+    while True:
+        case_started = time.time()
+        run_res = run_fn(
+            prompt=prompt,
+            work_dir=work_dir,
+            sandbox_dir=case_dir,
+            timeout_s=timeout_sec,
+            api_provider=api_provider2,
+        )
+        duration_ms = int((time.time() - case_started) * 1000)
+        st = str(run_res.get("status") or "").strip().lower()
+        if st != "error" or attempt >= _TRANSIENT_RETRIES or not _is_transient_error(run_res):
+            break
+        attempt += 1
+        delay = min(30.0, 5.0 * (2 ** (attempt - 1)))
+        snippet = str(run_res.get("errorMessage") or "")[:160].replace("\n", " ")
+        print(f"[transient-retry] case {case_id} attempt {attempt}/{_TRANSIENT_RETRIES} after transient error; retry in {delay:.0f}s :: {snippet}", flush=True)
+        time.sleep(delay)
 
     status_raw = str(run_res.get("status") or "").strip().lower()
     if status_raw not in {"ok", "timeout", "error"}:
